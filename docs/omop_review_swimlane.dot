digraph OMOPReviewSwimlane {
    rankdir=TB;
    newrank=true;
    bgcolor="#F4F1EC";
    label="OMOP Mapping Review Cycle";
    labelloc="t"; fontsize=26; fontname="Helvetica-Bold"; fontcolor="#5A1A33";
    nodesep=0.35; ranksep=0.6;
    node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=12,
          color="#7FA8D8", fillcolor="#D6E4F5", margin="0.18,0.12", penwidth=1.4];
    edge [color="#444444", penwidth=1.4, arrowsize=0.8];

    LANE [shape=plaintext, fillcolor="none", color="none", fontname="Helvetica-Bold",
          fontsize=14, fontcolor="white"];

    // ---- lane header bars ----
    h1 [label="1 · DETECT  (Unity Catalog)",       shape=box, style="filled", fillcolor="#5A1A33", fontcolor="white", fontname="Helvetica-Bold", color="#5A1A33"];
    h2 [label="2 · EXPOSE  (Databricks App)",       shape=box, style="filled", fillcolor="#5A1A33", fontcolor="white", fontname="Helvetica-Bold", color="#5A1A33"];
    h3 [label="3 · REVIEW  (Researchers)",          shape=box, style="filled", fillcolor="#5A1A33", fontcolor="white", fontname="Helvetica-Bold", color="#5A1A33"];
    h4 [label="4 · APPROVE  (Governance)",          shape=box, style="filled", fillcolor="#5A1A33", fontcolor="white", fontname="Helvetica-Bold", color="#5A1A33"];
    h5 [label="5 · COMMIT & TRACK  (Pipeline → UC)", shape=box, style="filled", fillcolor="#5A1A33", fontcolor="white", fontname="Helvetica-Bold", color="#5A1A33"];

    // ---- DETECT ----
    d0 [label="Scan CDM clinical tables"];
    d1 [label="Flag unmapped\nstandard_concept_id = 0"];
    d2 [label="Worklist: 1 row per\nsource code, by domain"];
    d3 [label="Prioritize + suppress\ncounts < 11"];

    // ---- EXPOSE ----
    e0 [label="SSO login\n(service principal)"];
    e1 [label="Read worklist + concept\npicker (SQL Warehouse)"];
    e2 [label="Per-row: Review button"];

    // ---- REVIEW ----
    v0 [label="Open review form"];
    v1 [label="Choose decision"];
    v2 [label="REMAP · NEW_LOCAL_CONCEPT\nUNMAPPABLE · NEEDS_INFO"];
    v3 [label="Submit review\n→ review (Lakebase)"];

    // ---- APPROVE ----
    a0 [label="Review proposals\n(visible, attributed)"];
    a1 [label="Approve / Merge /\nReject / Return"];
    a2 [label="SoD: approver ≠ reviewer"];
    a3 [label="Approve → lock\n→ code_status (Lakebase)"];

    // ---- COMMIT & TRACK ----
    c0 [label="Get approved entries\n(federated read)"];
    c1 [label="Upsert source_to_concept_map\nmint 2B concept"];
    c2 [label="Re-derive clinical\n*_concept_id (MERGE)"];
    c3 [label="mapping_update_log +\ncoverage re-measured"];

    // ---- vertical flow within each lane (gives ranks) ----
    h1->d0->d1->d2->d3;
    h2->e0->e1->e2;
    h3->v0->v1->v2->v3;
    h4->a0->a1->a2->a3;
    h5->c0->c1->c2->c3;

    // ---- horizontal ordering of lanes (flat, invisible) ----
    { rank=same; h1; h2; h3; h4; h5; }
    h1->h2->h3->h4->h5 [style=invis];
    { rank=same; d0; e0; v0; a0; c0; }
    d0->e0->v0->a0->c0 [style=invis];
    { rank=same; d1; e1; v1; a1; c1; }
    d1->e1->v1->a1->c1 [style=invis];
    { rank=same; d2; e2; v2; a2; c2; }
    d2->e2->v2->a2->c2 [style=invis];
    { rank=same; d3; v3; a3; c3; }
    d3->v3->a3->c3 [style=invis];

    // ---- sequential hand-offs between lanes ----
    d2->e1 [constraint=false, color="#1A7F37", penwidth=2.2, label="worklist", fontcolor="#1A7F37", fontsize=10];
    e2->v0 [constraint=false, color="#1A7F37", penwidth=2.2];
    v3->a0 [constraint=false, color="#1A7F37", penwidth=2.2, label="reviewed", fontcolor="#1A7F37", fontsize=10];
    a3->c0 [constraint=false, color="#1A7F37", penwidth=2.2, label="approved", fontcolor="#1A7F37", fontsize=10];

    // ---- data stores ----
    subgraph cluster_lb {
        label="Lakebase  (transactional review state)";
        style="filled,rounded"; fillcolor="#FFF7E6"; color="#E0B873";
        fontname="Helvetica-Bold"; fontsize=13; fontcolor="#8A5A12";
        rev  [label="review", shape=cylinder, fillcolor="#FFF0CC", color="#E0B873"];
        cs   [label="code_status", shape=cylinder, fillcolor="#FFF0CC", color="#E0B873"];
    }
    subgraph cluster_uc {
        label="Unity Catalog  (CDM + system of record)";
        style="filled,rounded"; fillcolor="#EAF1FB"; color="#7FA8D8";
        fontname="Helvetica-Bold"; fontsize=13; fontcolor="#27496D";
        cdm  [label="omop_cdm (locked):\nconcept · concept_relationship\nsource_to_concept_map", shape=cylinder, fillcolor="#DCE9F8", color="#7FA8D8"];
        log  [label="omop_review:\nworklist views · mapping_update_log", shape=cylinder, fillcolor="#DCE9F8", color="#7FA8D8"];
    }

    { rank=same; rev; cs; cdm; log; }

    // ---- store reads/writes ----
    cdm->d0  [style=dashed, color="#27496D", label="read", fontsize=9, fontcolor="#27496D"];
    v3->rev  [style=dashed, color="#B07D2B", label="write", fontsize=9, fontcolor="#B07D2B"];
    a3->cs   [style=dashed, color="#B07D2B", label="write", fontsize=9, fontcolor="#B07D2B"];
    cs->c0   [style=dashed, color="#B07D2B", label="read", fontsize=9, fontcolor="#B07D2B", constraint=false];
    c1->cdm  [style=dashed, color="#27496D", label="upsert", fontsize=9, fontcolor="#27496D", constraint=false];
    c3->log  [style=dashed, color="#27496D", label="write", fontsize=9, fontcolor="#27496D", constraint=false];

    // ---- the loop ----
    c3->d0 [constraint=false, color="#1A7F37", penwidth=2.4, style=bold,
            label="next data load (loop)", fontcolor="#1A7F37", fontsize=11];
}
